# ============================================================
#  LogMax — Variáveis de ambiente
#  Copie este ficheiro para `.env` e preencha os valores reais.
#  NUNCA commit o `.env` (está no .gitignore).
# ============================================================

# Supabase — credenciais públicas (expostas ao browser via VITE_*)
VITE_SUPABASE_URL=https://<seu-projeto>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Supabase — chave server-only (NUNCA expor ao cliente; usado em /api/*)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Secret HMAC dedicado para tokens QR de ponto (separado do service_role
# para limitar blast radius se vazar). Gerar com:
#   openssl rand -hex 32
QR_TOKEN_SECRET=

# URL pública da app — usado para validar CORS Origin nos endpoints sensíveis.
# Em desenvolvimento, o CORS já aceita localhost:3000/3001/5173 automaticamente.
VITE_APP_URL=https://seu-dominio.vercel.app

# Gemini API key (provedor primário de IA — usado nos 4 endpoints /api/ai-*)
GEMINI_API_KEY=

# Override opcional da cadeia de modelos Gemini (CSV). Default (todos free tier):
# gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash,gemini-2.5-flash-lite
# GEMINI_MODELS=gemini-3.6-flash,gemini-2.5-flash
# GEMINI_MODEL (valor único) ainda é aceito e desativa a cadeia.

# Cerebras API key (fallback Tier 2 — Wafer-scale, ~1000 tok/s em modelo 120B).
# Crie chave grátis em https://cloud.cerebras.ai/platform/ — sem cartão.
# Opcional mas RECOMENDADO: latência <1s pra respostas longas.
CEREBRAS_API_KEY=

# Override opcional dos modelos Cerebras (CSV). Default:
# gpt-oss-120b,gemma-4-31b
# CEREBRAS_MODELS=gpt-oss-120b,gemma-4-31b

# Mistral API key (fallback Tier 3 — bom PT-BR nativo, JSON mode confiável).
# Crie chave grátis em https://console.mistral.ai/api-keys — sem cartão.
# Free tier: 1 req/s, 500k tokens/min.
MISTRAL_API_KEY=

# Override opcional dos modelos Mistral (CSV). Default:
# mistral-small-latest,mistral-small-2603,ministral-3-8b-25-12
# MISTRAL_MODELS=mistral-small-latest,ministral-3-8b-25-12

# Groq API key (fallback Tier 4 — LPU rápida, free tier alto ~14k req/dia).
# Crie chave grátis em https://console.groq.com/keys — sem cartão.
# Opcional mas RECOMENDADO: cobre alta demanda do Gemini com latência baixa
# (modelo padrão openai/gpt-oss-120b responde em ~2-3s).
GROQ_API_KEY=

# Override opcional dos modelos Groq (CSV). Default:
# openai/gpt-oss-120b,openai/gpt-oss-20b
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# OpenRouter API key (fallback Tier 5 — backup do backup, free tier baixo).
# Crie chave grátis em https://openrouter.ai/keys — sem cartão, modelos free
# como nemotron-3-ultra-550b, gemma-4-31b, gpt-oss-20b cobrem ~50 req/dia cada.
# Opcional: só dispara se Gemini E Groq estiverem fora.
OPENROUTER_API_KEY=

# Override opcional da cadeia de modelos do OpenRouter (CSV). Default:
# nemotron-3-ultra-550b:free, nemotron-3-super-120b:free, gemma-4-31b-it:free,
# gpt-oss-20b:free. A lista free rotaciona — conferir em
# https://openrouter.ai/api/v1/models (ids terminados em ':free').
# OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free

# Secret Bearer para o Vercel Cron chamar /api/reverter-promocoes-expiradas.
# Sem esta variável, o cron diário devolve 500 e promoções expiradas nunca são
# revertidas. Gerar com:
#   openssl rand -hex 32
CRON_SECRET=

# Sentry DSN — error tracking + performance (10% sample). Em dev pode ficar
# vazio (Sentry no-op). Em produção, obter em:
# https://sentry.io → seu projeto → Settings → Client Keys (DSN)
VITE_SENTRY_DSN=

# ============================================================
#  Integração MaxBank — Área Cliente Pix (Fase 1)
#  Sem estas envs, o QR do PDV volta pro formato antigo
#  LOGMAX-PIX-<uuid> (só operador MaxBank lê). Preenchidas,
#  o QR vira URL clicável e o cliente paga sem cadastro.
# ============================================================

# URL pública do MaxBank (sem trailing slash). Ex.: https://maxbank.vercel.app
VITE_MAXBANK_URL=

# BranchId desta turma no MaxBank (ver src/lib/supabase.ts do MaxBank):
# LogMax ERP=1, LogMax Contabilidade=2, LogMax Aprendiz=3, LogMax ADM=4.
VITE_MAXBANK_BRANCH_ID=

# ============================================================
#  Desenvolvimento
# ============================================================

# Registra o service worker do PWA também no `vite dev`. Desligado por padrão:
# em dev o Vite serve um módulo por arquivo, e o SW interceptando milhares de
# requests deixa o dev server lento em todas as telas. Ligue só para testar
# banner de atualização ou comportamento offline. Não afeta produção.
VITE_PWA_DEV=

# ============================================================
#  Lojas online (hubs das filiais)
# ============================================================

# Origens das lojas publicadas, separadas por vírgula. Cada loja vive num
# projeto Vercel próprio e chama /api/loja cross-origin — sem estar nesta
# lista, o navegador bloqueia por CORS e a loja mostra erro de conexão.
# Ex.: https://maxlook-loja.vercel.app,https://supermax-loja.vercel.app
LOJA_ORIGINS=

# Sal do hash de IP usado só para limitar pedidos por hora na loja. O IP cru
# nunca é gravado. Se vazia, cai no CRON_SECRET.
LOJA_IP_SALT=
