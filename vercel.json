{
  "ignoreCommand": "bash scripts/vercel-ignore.sh",
  "functions": {
    "api/ai-*.ts": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron?task=reverter-promocoes",
      "schedule": "5 3 * * *"
    },
    {
      "path": "/api/cron?task=expirar-competicoes,limpar-ip-hash,lembrar-avaliacoes,encerrar-aulas",
      "schedule": "10 3 * * *"
    }
  ]
}
